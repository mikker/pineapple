{
  "name": "pineapple",
  "workspaces": [
    "extensions/*"
  ],
  "pi": {
    "extensions": [
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/file-search/index.ts",
      "./extensions/firecrawl-search/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/inline-skills/index.ts",
      "./extensions/prompt-box/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "overrides": {
    "effect": "$effect"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "node scripts/check-dependencies.mjs && node scripts/check-runtime.mjs && tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.json\"",
    "test": "node scripts/test.mjs",
    "test:live": "node --test extensions/subagents/claude.test.ts extensions/subagents/codex.test.ts"
  }
}
